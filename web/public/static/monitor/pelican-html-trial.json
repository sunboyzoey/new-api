{"schema_version":1,"target_id":"AmXfK8KAH0uraBgvpnxwiMuo","group":"GPT PRO (退款流)","model":"gpt-6.2-astra","finished_at":1795446187068,"html":"<!DOCTYPE html>\n<html lang=\"zh-CN\">\n<head>\n  <meta charset=\"UTF-8\" />\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\" />\n  <title>鹈鹕的海边骑行</title>\n  <style>\n    :root {\n      color-scheme: light;\n      --ink: #294d55;\n      --paper: #fffdf6;\n      --cycle: 1.2s;\n    }\n\n    * { box-sizing: border-box; }\n\n    body {\n      margin: 0;\n      min-height: 100vh;\n      display: grid;\n      place-items: center;\n      padding: 24px;\n      background: #eaf1eb;\n      color: var(--ink);\n      font-family: system-ui, -apple-system, \"Segoe UI\", sans-serif;\n    }\n\n    .card {\n      width: min(100%, 980px);\n      overflow: hidden;\n      background: var(--paper);\n      border: 1px solid #294d5515;\n      border-radius: 28px;\n      box-shadow: 0 24px 80px #294d5514;\n    }\n\n    header {\n      display: flex;\n      align-items: center;\n      justify-content: space-between;\n      gap: 20px;\n      padding: 28px 34px 12px;\n    }\n\n    .eyebrow {\n      margin: 0 0 7px;\n      color: #70938c;\n      font-size: 11px;\n      font-weight: 700;\n      letter-spacing: 3px;\n    }\n\n    h1 {\n      margin: 0;\n      font-size: clamp(23px, 4vw, 34px);\n      font-weight: 750;\n      letter-spacing: 1px;\n    }\n\n    .badge {\n      flex-shrink: 0;\n      padding: 8px 13px;\n      border: 1px solid #dbe7dd;\n      border-radius: 999px;\n      color: #6c8c80;\n      font-size: 12px;\n    }\n\n    svg {\n      display: block;\n      width: 100%;\n      height: auto;\n    }\n\n    footer {\n      display: flex;\n      justify-content: space-between;\n      align-items: center;\n      gap: 16px;\n      padding: 18px 34px 25px;\n    }\n\n    footer p {\n      margin: 0;\n      color: #7b928c;\n      font-size: 13px;\n      line-height: 1.6;\n    }\n\n    button {\n      flex-shrink: 0;\n      padding: 10px 17px;\n      border: 1px solid #d5e2da;\n      border-radius: 999px;\n      background: transparent;\n      color: var(--ink);\n      font: inherit;\n      font-size: 13px;\n      cursor: pointer;\n      transition: background .2s, transform .2s;\n    }\n\n    button:hover { background: #edf4ed; }\n    button:active { transform: scale(.97); }\n    button:focus-visible {\n      outline: 3px solid #edaa56;\n      outline-offset: 4px;\n    }\n\n    .spin {\n      transform-origin: 0 0;\n      animation: spin var(--cycle) linear infinite;\n    }\n\n    .counter-spin {\n      transform-origin: 0 0;\n      animation: spin var(--cycle) linear infinite reverse;\n    }\n\n    .ride {\n      animation: bounce .6s ease-in-out infinite;\n    }\n\n    .road-flow { animation: road 1.2s linear infinite; }\n    .sea-flow { animation: sea 9s linear infinite; }\n    .cloud-flow { animation: clouds 36s linear infinite; }\n\n    .scarf-tip {\n      transform-box: fill-box;\n      transform-origin: right center;\n      animation: flutter .6s ease-in-out infinite alternate;\n    }\n\n    .wind {\n      animation: breeze 2s ease-in-out infinite;\n    }\n\n    .wind.second { animation-delay: -.9s; }\n\n    .blink {\n      transform-box: fill-box;\n      transform-origin: center;\n      animation: blink 5s infinite;\n    }\n\n    .paused * { animation-play-state: paused !important; }\n\n    @keyframes spin { to { transform: rotate(360deg); } }\n    @keyframes bounce {\n      0%, 100% { transform: translateY(0); }\n      50% { transform: translateY(-2.5px); }\n    }\n    @keyframes road { to { transform: translateX(-180px); } }\n    @keyframes sea { to { transform: translateX(-300px); } }\n    @keyframes clouds { to { transform: translateX(-900px); } }\n    @keyframes flutter {\n      from { transform: rotate(-5deg); }\n      to { transform: rotate(7deg); }\n    }\n    @keyframes breeze {\n      0%, 100% { opacity: .15; transform: translateX(8px); }\n      50% { opacity: .75; transform: translateX(-12px); }\n    }\n    @keyframes blink {\n      0%, 43%, 47%, 100% { transform: scaleY(1); }\n      45% { transform: scaleY(.08); }\n    }\n\n    @media (max-width: 540px) {\n      body { padding: 12px; }\n      .card { border-radius: 20px; }\n      header { padding: 23px 22px 8px; }\n      footer { padding: 14px 22px 22px; }\n      .badge { display: none; }\n      footer p { max-width: 190px; font-size: 12px; }\n    }\n\n    @media (prefers-reduced-motion: reduce) {\n      button { transition: none; }\n      .card:not(.motion-enabled) * {\n        animation-play-state: paused !important;\n      }\n    }\n  </style>\n</head>\n\n<body>\n  <main class=\"card\" id=\"card\">\n    <header>\n      <div>\n        <p class=\"eyebrow\">SLOW DAYS · SEASIDE CLUB</p>\n        <h1>让海风带路。</h1>\n      </div>\n      <span class=\"badge\">今日宜 · 慢慢骑</span>\n    </header>\n\n    <svg\n      id=\"scene\"\n      viewBox=\"0 0 900 570\"\n      xmlns=\"http://www.w3.org/2000/svg\"\n      role=\"img\"\n      aria-labelledby=\"scene-title scene-desc\"\n    >\n      <title id=\"scene-title\">鹈鹕的海边骑行</title>\n      <desc id=\"scene-desc\">\n        一只白色鹈鹕戴着绿色围巾，骑着珊瑚红自行车沿海岸前行。\n        它交替踩动踏板，车轮不断旋转，云朵、海浪与路面缓缓向后移动。\n      </desc>\n\n      <defs>\n        <linearGradient id=\"sky\" x1=\"0\" y1=\"0\" x2=\"0\" y2=\"1\">\n          <stop offset=\"0\" stop-color=\"#fffdf6\" />\n          <stop offset=\"1\" stop-color=\"#eaf4ed\" />\n        </linearGradient>\n\n        <linearGradient id=\"sea\" x1=\"0\" y1=\"0\" x2=\"0\" y2=\"1\">\n          <stop offset=\"0\" stop-color=\"#b7dcd4\" />\n          <stop offset=\"1\" stop-color=\"#d6e9db\" />\n        </linearGradient>\n\n        <pattern id=\"road-marks\" width=\"180\" height=\"90\" patternUnits=\"userSpaceOnUse\">\n          <path\n            d=\"M22 48H76 M120 19h18 M142 72h11\"\n            fill=\"none\"\n            stroke=\"#c9c7ad\"\n            stroke-width=\"3\"\n            stroke-linecap=\"round\"\n          />\n        </pattern>\n\n        <pattern id=\"wave-marks\" width=\"300\" height=\"100\" patternUnits=\"userSpaceOnUse\">\n          <path\n            d=\"M20 28h65 M145 56h95 M95 84h28\"\n            fill=\"none\"\n            stroke=\"#f5fff5\"\n            stroke-width=\"3\"\n            stroke-linecap=\"round\"\n            opacity=\".65\"\n          />\n        </pattern>\n\n        <clipPath id=\"scene-clip\">\n          <rect width=\"900\" height=\"570\" />\n        </clipPath>\n\n        <g id=\"cloud\" fill=\"#fff\" opacity=\".85\">\n          <path d=\"M0 22C0 10 13 5 24 10C29-6 54-5 61 10C75 4 90 12 90 24H0Z\" />\n        </g>\n\n        <g id=\"wheel\">\n          <circle r=\"83\" fill=\"#fffdf6\" fill-opacity=\".35\" stroke=\"#294d55\" stroke-width=\"9\" />\n          <circle r=\"75\" fill=\"none\" stroke=\"#fcfaf0\" stroke-width=\"3\" />\n          <g stroke=\"#789795\" stroke-width=\"2\" opacity=\".85\">\n            <path d=\"M-73 0H73 M0-73V73\" />\n            <path d=\"M-51.6-51.6L51.6 51.6 M-51.6 51.6L51.6-51.6\" />\n            <path d=\"M-67.4-27.9L67.4 27.9 M-27.9-67.4L27.9 67.4\" />\n            <path d=\"M-67.4 27.9L67.4-27.9 M-27.9 67.4L27.9-67.4\" />\n          </g>\n          <path d=\"M-22-79A82 82 0 0 1 22-79\" fill=\"none\" stroke=\"#e6b65d\" stroke-width=\"4\" />\n          <circle r=\"8\" fill=\"#f8f5e9\" stroke=\"#294d55\" stroke-width=\"3\" />\n        </g>\n      </defs>\n\n      <g clip-path=\"url(#scene-clip)\">\n        <!-- 天空、太阳和循环漂移的云。 -->\n        <rect width=\"900\" height=\"570\" fill=\"url(#sky)\" />\n        <circle cx=\"720\" cy=\"113\" r=\"49\" fill=\"#f5d887\" />\n        <circle cx=\"720\" cy=\"113\" r=\"62\" fill=\"none\" stroke=\"#f5d887\" opacity=\".25\" />\n\n        <g class=\"cloud-flow\">\n          <use href=\"#cloud\" x=\"100\" y=\"92\" />\n          <use href=\"#cloud\" x=\"570\" y=\"58\" />\n          <use href=\"#cloud\" x=\"835\" y=\"155\" />\n          <use href=\"#cloud\" x=\"1000\" y=\"92\" />\n          <use href=\"#cloud\" x=\"1470\" y=\"58\" />\n          <use href=\"#cloud\" x=\"1735\" y=\"155\" />\n        </g>\n\n        <!-- 远方的小岛与海面。 -->\n        <path d=\"M0 294Q77 255 144 292Q230 235 323 294Z\" fill=\"#adc9bc\" opacity=\".55\" />\n        <path d=\"M657 294Q720 257 772 283Q832 241 900 281V304H657Z\" fill=\"#adc9bc\" opacity=\".55\" />\n\n        <rect y=\"294\" width=\"900\" height=\"147\" fill=\"url(#sea)\" />\n        <path d=\"M0 295H900\" stroke=\"#a4cec5\" stroke-width=\"2\" />\n\n        <g class=\"sea-flow\">\n          <rect x=\"0\" y=\"300\" width=\"1200\" height=\"130\" fill=\"url(#wave-marks)\" />\n        </g>\n\n        <path d=\"M0 421Q215 409 450 425T900 420V570H0Z\" fill=\"#efe7ce\" />\n        <path d=\"M0 433Q240 422 470 437T900 431\" fill=\"none\" stroke=\"#fff8e6\" stroke-width=\"7\" />\n        <path d=\"M0 475H900V570H0Z\" fill=\"#e5e3ce\" />\n\n        <g class=\"road-flow\">\n          <rect x=\"0\" y=\"475\" width=\"1080\" height=\"95\" fill=\"url(#road-marks)\" />\n        </g>\n\n        <!-- 速度线。 -->\n        <g fill=\"none\" stroke=\"#83aaa0\" stroke-width=\"3\" stroke-linecap=\"round\">\n          <g class=\"wind\">\n            <path d=\"M227 234h58 M207 251h43\" />\n          </g>\n          <g class=\"wind second\">\n            <path d=\"M666 263h48 M692 278h31\" />\n          </g>\n        </g>\n\n        <ellipse cx=\"451\" cy=\"519\" rx=\"207\" ry=\"13\" fill=\"#4c6a5b\" opacity=\".12\" />\n\n        <g class=\"ride\">\n          <!-- 车轮：与脚踏使用相同周期，确保运动协调。 -->\n          <g transform=\"translate(320 430)\">\n            <g class=\"spin\"><use href=\"#wheel\" /></g>\n          </g>\n          <g transform=\"translate(580 430)\">\n            <g class=\"spin\"><use href=\"#wheel\" /></g>\n          </g>\n\n          <!-- 远侧腿，置于车架后方。 -->\n          <path\n            d=\"M421 312L435 362L410 430\"\n            fill=\"none\"\n            stroke=\"#ce8a45\"\n            stroke-width=\"12\"\n            stroke-linecap=\"round\"\n            stroke-linejoin=\"round\"\n          >\n            <animate\n              attributeName=\"d\"\n              dur=\"1.2s\"\n              repeatCount=\"indefinite\"\n              values=\"\n                M421 312L435 362L410 430;\n                M421 312L449 345L440 400;\n                M421 312L473 363L470 430;\n                M421 312L459 379L440 460;\n                M421 312L435 362L410 430\n              \"\n            />\n          </path>\n\n          <!-- 挡泥板与车架。 -->\n          <g fill=\"none\" stroke-linecap=\"round\" stroke-linejoin=\"round\">\n            <path d=\"M239 404A87 87 0 0 1 394 388\" stroke=\"#e9b169\" stroke-width=\"6\" />\n            <path d=\"M504 387A87 87 0 0 1 660 400\" stroke=\"#e9b169\" stroke-width=\"6\" />\n\n            <g stroke=\"#df7461\" stroke-width=\"10\">\n              <path d=\"M320 430L399 346L440 430Z\" />\n              <path d=\"M399 346L548 346L440 430\" />\n              <path d=\"M548 346L580 430\" />\n              <path d=\"M399 346L391 321\" />\n            </g>\n\n            <path d=\"M548 346L539 313Q537 302 550 299L573 295\" stroke=\"#294d55\" stroke-width=\"7\" />\n            <path d=\"M564 296L583 293\" stroke=\"#9c694d\" stroke-width=\"9\" />\n            <path d=\"M544 313Q587 330 571 397\" stroke=\"#47666a\" stroke-width=\"2\" />\n\n            <path d=\"M370 320Q390 316 416 322\" stroke=\"#294d55\" stroke-width=\"12\" />\n            <path d=\"M373 317H405\" stroke=\"#a47d5f\" stroke-width=\"5\" />\n\n            <path d=\"M320 430L440 418A13 13 0 0 1 440 442Z\" stroke=\"#587674\" stroke-width=\"3\" />\n          </g>\n\n          <circle cx=\"440\" cy=\"430\" r=\"20\" fill=\"#fff9e9\" stroke=\"#294d55\" stroke-width=\"4\" />\n          <circle cx=\"440\" cy=\"430\" r=\"12\" fill=\"none\" stroke=\"#8ba19a\" stroke-width=\"2\" />\n\n          <!-- 曲柄和始终保持水平的踏板。 -->\n          <g transform=\"translate(440 430)\">\n            <g class=\"spin\">\n              <path d=\"M-30 0H30\" stroke=\"#294d55\" stroke-width=\"6\" stroke-linecap=\"round\" />\n              <g transform=\"translate(-30 0)\">\n                <g class=\"counter-spin\">\n                  <rect x=\"-14\" y=\"-4\" width=\"28\" height=\"8\" rx=\"3\" fill=\"#476266\" />\n                </g>\n              </g>\n              <g transform=\"translate(30 0)\">\n                <g class=\"counter-spin\">\n                  <rect x=\"-14\" y=\"-4\" width=\"28\" height=\"8\" rx=\"3\" fill=\"#294d55\" />\n                </g>\n              </g>\n            </g>\n          </g>\n\n          <!-- 鹈鹕尾羽。 -->\n          <path\n            d=\"M377 279Q341 282 326 260L352 263L333 243Q368 245 393 260Z\"\n            fill=\"#f8faf1\"\n            stroke=\"#294d55\"\n            stroke-width=\"3\"\n            stroke-linejoin=\"round\"\n          />\n\n          <!-- 身体及弯曲的长颈。 -->\n          <path\n            d=\"M391 324\n               C361 310 352 281 365 252\n               C378 222 410 211 440 223\n               C456 214 462 188 466 165\n               C470 137 486 119 510 120\n               C532 120 548 135 546 155\n               C544 173 526 179 510 178\n               C505 202 504 231 489 260\n               C481 283 473 307 452 320\n               C433 332 411 334 391 324Z\"\n            fill=\"#fffdf3\"\n            stroke=\"#294d55\"\n            stroke-width=\"3.5\"\n            stroke-linejoin=\"round\"\n          />\n\n          <path\n            d=\"M379 286Q387 321 421 323Q450 324 469 299Q448 311 423 304Q399 298 379 286Z\"\n            fill=\"#e3eade\"\n          />\n\n          <!-- 头顶几根轻盈的羽毛。 -->\n          <path\n            d=\"M484 131Q477 114 485 107M492 125Q489 108 498 102M501 123Q502 112 510 108\"\n            fill=\"none\"\n            stroke=\"#294d55\"\n            stroke-width=\"3\"\n            stroke-linecap=\"round\"\n          />\n\n          <!-- 夸张的长喙与鹈鹕特征性的喉囊。 -->\n          <path\n            d=\"M532 155L648 165\n               Q610 202 574 211\n               Q543 215 522 174Z\"\n            fill=\"#edb65d\"\n            stroke=\"#294d55\"\n            stroke-width=\"3\"\n            stroke-linejoin=\"round\"\n          />\n          <path d=\"M538 169Q556 204 581 203Q609 195 637 172\" fill=\"#f5ca7c\" />\n          <path\n            d=\"M533 143Q588 145 651 163Q656 166 648 170L533 163Z\"\n            fill=\"#f4cf76\"\n            stroke=\"#294d55\"\n            stroke-width=\"3\"\n            stroke-linejoin=\"round\"\n          />\n          <path d=\"M546 157L632 165\" stroke=\"#c48e43\" stroke-width=\"2\" stroke-linecap=\"round\" />\n\n          <!-- 眼睛与脸颊。 -->\n          <circle cx=\"516\" cy=\"143\" r=\"11\" fill=\"#f4e7bb\" />\n          <g class=\"blink\">\n            <circle cx=\"518\" cy=\"143\" r=\"5\" fill=\"#294d55\" />\n            <circle cx=\"519.5\" cy=\"141.5\" r=\"1.5\" fill=\"#fff\" />\n          </g>\n          <path d=\"M501 159Q507 163 512 160\" fill=\"none\" stroke=\"#d5b790\" stroke-width=\"2.5\" stroke-linecap=\"round\" />\n\n          <!-- 围巾与迎风摆动的尾端。 -->\n          <g class=\"scarf-tip\">\n            <path\n              d=\"M476 207Q436 197 408 203L419 216L402 225Q441 227 480 220Z\"\n              fill=\"#4e9180\"\n              stroke=\"#294d55\"\n              stroke-width=\"2.5\"\n              stroke-linejoin=\"round\"\n            />\n            <path d=\"M422 211Q445 207 468 213\" fill=\"none\" stroke=\"#85b4a0\" stroke-width=\"3\" />\n          </g>\n          <path\n            d=\"M466 201Q482 212 505 208L501 225Q479 231 462 216Z\"\n            fill=\"#6aa38c\"\n            stroke=\"#294d55\"\n            stroke-width=\"2.5\"\n          />\n\n          <!-- 近侧腿：端点与旋转踏板同步。 -->\n          <path\n            d=\"M435 315L481 370L470 430\"\n            fill=\"none\"\n            stroke=\"#e7a655\"\n            stroke-width=\"13\"\n            stroke-linecap=\"round\"\n            stroke-linejoin=\"round\"\n          >\n            <animate\n              attributeName=\"d\"\n              dur=\"1.2s\"\n              repeatCount=\"indefinite\"\n              values=\"\n                M435 315L481 370L470 430;\n                M435 315L470 380L440 460;\n                M435 315L437 365L410 430;\n                M435 315L450 348L440 400;\n                M435 315L481 370L470 430\n              \"\n            />\n          </path>\n\n          <!-- 蹼足始终平放在踏板上。 -->\n          <path\n            d=\"M462 423L483 425L489 430L460 430Z\"\n            fill=\"#efb55d\"\n            stroke=\"#294d55\"\n            stroke-width=\"2\"\n            stroke-linejoin=\"round\"\n          >\n            <animate\n              attributeName=\"d\"\n              dur=\"1.2s\"\n              repeatCount=\"indefinite\"\n              values=\"\n                M462 423L483 425L489 430L460 430Z;\n                M432 453L453 455L459 460L430 460Z;\n                M402 423L423 425L429 430L400 430Z;\n                M432 393L453 395L459 400L430 400Z;\n                M462 423L483 425L489 430L460 430Z\n              \"\n            />\n          </path>\n\n          <!-- 翅膀向前伸到车把，保留羽毛轮廓。 -->\n          <path\n            d=\"M402 243\n               Q426 231 450 253\n               Q473 279 502 286\n               L563 288\n               Q577 289 576 296\n               Q575 305 562 305\n               L506 307\n               Q463 310 431 285\n               Q407 277 402 260Z\"\n            fill=\"#f8faf1\"\n            stroke=\"#294d55\"\n            stroke-width=\"3\"\n            stroke-linejoin=\"round\"\n          />\n          <g fill=\"none\" stroke=\"#b5c8bc\" stroke-width=\"2.5\" stroke-linecap=\"round\">\n            <path d=\"M419 253Q443 279 478 289\" />\n            <path d=\"M416 266Q438 286 460 291\" />\n            <path d=\"M527 295L562 296\" />\n          </g>\n\n          <circle cx=\"440\" cy=\"430\" r=\"5\" fill=\"#294d55\" />\n        </g>\n\n        <!-- 静态小装饰，形成海边明信片的观感。 -->\n        <g transform=\"translate(755 471)\" fill=\"none\" stroke=\"#77967b\" stroke-width=\"3\" stroke-linecap=\"round\">\n          <path d=\"M0 21Q-2 4-10-3M0 21Q5 0 14-8M0 21Q13 9 22 11\" />\n        </g>\n\n        <g transform=\"translate(114 462)\" fill=\"none\" stroke=\"#98a187\" stroke-width=\"2.5\" stroke-linecap=\"round\">\n          <path d=\"M0 15Q0 5-6 0M0 15Q5 2 10 0\" />\n        </g>\n      </g>\n    </svg>\n\n    <footer>\n      <p>不赶时间，只追海风。<br />一只鹈鹕的悠闲出走。</p>\n      <button id=\"toggle\" type=\"button\" aria-pressed=\"false\" aria-label=\"暂停动画\">\n        暂停动画\n      </button>\n    </footer>\n  </main>\n\n  <script>\n    (() => {\n      const card = document.getElementById(\"card\");\n      const scene = document.getElementById(\"scene\");\n      const button = document.getElementById(\"toggle\");\n      const preference = window.matchMedia(\"(prefers-reduced-motion: reduce)\");\n      let paused = false;\n\n      function setPaused(value) {\n        paused = value;\n        card.classList.toggle(\"paused\", paused);\n        card.classList.toggle(\"motion-enabled\", !paused);\n\n        // SVG 腿部动画与 CSS 车轮动画一起暂停、继续。\n        if (paused) {\n          scene.pauseAnimations();\n        } else {\n          scene.unpauseAnimations();\n        }\n\n        button.textContent = paused ? \"播放动画\" : \"暂停动画\";\n        button.setAttribute(\"aria-label\", button.textContent);\n        button.setAttribute(\"aria-pressed\", String(paused));\n      }\n\n      // 从同一时间起点开始，让脚掌紧贴踏板。\n      scene.setCurrentTime(0);\n      setPaused(preference.matches);\n\n      button.addEventListener(\"click\", () => setPaused(!paused));\n      preference.addEventListener(\"change\", event => setPaused(event.matches));\n    })();\n  </script>\n</body>\n</html>\n"}